# Optional. The easiest way to add keys is the app's Setup page (paste and Save).
# Keys saved there override the ones in this file.
# To use this file instead: copy it to ".env" and fill in the values.

# Claude (AI ideas, scripts, titles, descriptions) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# AI voiceover — https://elevenlabs.io (profile → API Keys)
ELEVENLABS_API_KEY=

# Free stock footage — https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube upload + stats — Google Cloud OAuth client (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this app. The OAuth redirect URI is APP_URL + /api/youtube/callback
APP_URL=http://localhost:3000

# Protects the app with a password. Strongly recommended when deployed.
APP_PASSWORD=
# Signs the login cookie. Generated automatically if left empty.
SESSION_SECRET=

PORT=3000
# Set to 0.0.0.0 when running on a server so other devices can connect
HOST=127.0.0.1
